{
    "name": "denux/identity-server-bundle",
    "description": "JWT validation and Client Credentials support for Symfony projects",
    "type": "symfony-bundle",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "symfony/cache": "^7.4 || ^8.0",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/http-client": "^7.4 || ^8.0",
        "symfony/http-foundation": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/security-bundle": "^7.4 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Denux\\IdentityServerBundle\\": "src/"
        }
    },
    "extra": {
        "symfony": {
            "bundle": {
                "class": "Denux\\IdentityServerBundle\\IdentityServerBundle"
            }
        }
    }
}
